# Copy to .env and fill in. Never paste real values into chat or commit .env.

# PostgreSQL connection string, e.g. postgresql://user:password@localhost:5432/rudrika
DATABASE_URL=
# Long random string used to sign login sessions (openssl rand -hex 32)
SESSION_SECRET=
# Public site URL, used in links inside WhatsApp messages, invoices and the sitemap
NEXT_PUBLIC_SITE_URL=https://rudrika.in
NEXT_PUBLIC_STORE_NAME=Rudrika by Tara

# First admin account created by `npm run seed`. Leave blank to have the seed print a random password once.
SEED_ADMIN_EMAIL=admin@rudrika.in
SEED_ADMIN_PASSWORD=

# Razorpay. Blank keys keep the store in mock checkout mode (orders complete without payment).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# WhatsApp Cloud API (Phase 2). Blank keeps every message queued in Admin, WhatsApp.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Comma separated store numbers that receive the new-order alert, digits with country code
WHATSAPP_ADMIN_NUMBERS=
WHATSAPP_TEMPLATE_LANG=en
# Approved Meta template names per event. Blank sends plain text where the API allows it.
WHATSAPP_TEMPLATE_ADMIN=
WHATSAPP_TEMPLATE_CUSTOMER=
WHATSAPP_TEMPLATE_PACKED=
WHATSAPP_TEMPLATE_SHIPPED=
WHATSAPP_TEMPLATE_DELIVERED=
WHATSAPP_TEMPLATE_FEEDBACK=
WHATSAPP_TEMPLATE_PHOTO_REWARD=
WHATSAPP_TEMPLATE_RENEWAL=
WHATSAPP_TEMPLATE_WELCOME=
